# vast-forge runtime env. Copy to .env and fill in. On Vast, set these as the instance/template env vars.
# .env is gitignored — never commit real secrets.

# ── R2 (Cloudflare) — where the finished GLB is uploaded ────────────────────────────────────────────────────
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_KEY=<r2-access-key-id>
R2_SECRET=<r2-secret-access-key>          # NOTE: paste exactly — a stray comma/space breaks the S3 signature
R2_BUCKET=channel-clips
R2_PUBLIC_BASE=https://<public-r2-host>   # public https base that serves the bucket (no trailing slash)

# ── auth — shared secret between this service and the facet-generate edge function ──────────────────────────
FORGE_TOKEN=<long-random-string>          # must match the Supabase secret FORGE_TOKEN

# ── HuggingFace — REQUIRED: TRELLIS.2-4B pulls the GATED encoder facebook/dinov3-vitl16-pretrain-lvd1689m ────
# Accept the gate on your HF account (https://huggingface.co/settings/gated-repos), then use a CLASSIC read token
# (fine-grained tokens 403 on gated repos). huggingface_hub reads this automatically; no code wiring needed.
HF_TOKEN=hf_<classic-read-token-with-dinov3-access>

# ── optional tuning (have sensible defaults in server.py) ───────────────────────────────────────────────────
# TARGET_FACES=40000     # mobile triangle budget (to_glb decimation_target)
# TEXTURE_SIZE=1024      # mobile texture size (repo default 4096)
